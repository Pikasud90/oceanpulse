# OceanPulse configuration.
#
# Copy this file to `.env` and edit. Every setting is optional; the values
# shown are the defaults used when the file is absent.

# --- Ingestion -------------------------------------------------------------

# Minutes between polls. Must be 15, 30, 45 or 60. Also settable in the UI,
# where a change takes effect on the next cycle without a restart.
OCEAN_POLL_INTERVAL_MINUTES=30

# Roughly how many ocean cells the sparse global grid should contain. Points
# are spaced by equal area, not by equal degrees, so they are distributed
# evenly over the surface rather than piling up near the poles.
OCEAN_GRID_TARGET_POINTS=250

# Hours of overlap fetched on each poll. Open-Meteo returns a window, not an
# instant, so a couple of past days gives tolerance for missed cycles at
# almost no extra cost.
OCEAN_GRID_PAST_DAYS=2
OCEAN_GRID_FORECAST_DAYS=2
OCEAN_PORT_FORECAST_DAYS=3

# --- HTTP ------------------------------------------------------------------

OCEAN_RATE_LIMIT_PER_SECOND=2.0
OCEAN_RATE_LIMIT_BURST=4
OCEAN_HTTP_TIMEOUT=60
OCEAN_BACKOFF_MAX_ATTEMPTS=8

# --- Historical archive (NOAA ERDDAP) --------------------------------------

# ERDDAP serves sea temperature back to 1981 and sea level back to 2017.
# It is also the least reliable dependency here; set this to false to run
# entirely on Open-Meteo (2021 onwards, waves and currents only).
OCEAN_ERDDAP_ENABLED=true
OCEAN_ERDDAP_CHUNK_DAYS=365

# --- Gazetteer -------------------------------------------------------------

# cities15000 (~26k places) is the default. cities5000 (~55k) gives better
# small-town coverage at the cost of a larger download.
OCEAN_GEONAMES_DATASET=cities15000
OCEAN_GAZETTEER_INCLUDE_CITIES=true

# How far inland a place may sit and still count as coastal, in kilometres.
OCEAN_COASTAL_MAX_KM=60

# --- Web interface ---------------------------------------------------------

# Read the security section of the README before changing the host. Binding
# to 0.0.0.0 exposes your database to everyone on your network, unauthenticated.
OCEAN_HOST=127.0.0.1
OCEAN_PORT=8050
OCEAN_DEBUG=false
OCEAN_OPEN_BROWSER=true
OCEAN_RUN_DAEMON_IN_UI=true

# Server-side downsampling threshold for charts.
OCEAN_MAX_PLOT_POINTS=2500
OCEAN_MAX_EXPORT_ROWS=2000000

# --- Storage ---------------------------------------------------------------

OCEAN_DATA_DIR=./data
OCEAN_LOG_DIR=./logs
